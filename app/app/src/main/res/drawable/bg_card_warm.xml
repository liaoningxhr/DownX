<?xml version="1.0" encoding="utf-8"?>
<!-- 打赏卡片：普通卡片底 + 一层由左向右淡出的暖色，加一道很淡的橙色描边，
     让这一行在整页冷色卡片里第一眼就能看到 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#4DFF9A5C" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#2EFF8A4C"
                android:endColor="#00FF8A4C"
                android:type="linear" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</layer-list>
