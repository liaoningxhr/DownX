<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 卡面：竖向渐变 + 细描边 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#22222E"
                android:centerColor="#17171F"
                android:endColor="#0E0E13"
                android:type="linear" />
            <corners android:radius="26dp" />
            <stroke android:width="1dp" android:color="#2E2E3E" />
        </shape>
    </item>
    <!-- 顶部霓虹细线 -->
    <item
        android:gravity="top"
        android:height="2dp"
        android:left="104dp"
        android:right="104dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#001D9BF0"
                android:centerColor="#CC6FA8FF"
                android:endColor="#001D9BF0"
                android:type="linear" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
