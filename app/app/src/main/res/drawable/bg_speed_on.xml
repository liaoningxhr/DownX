<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 选中的倍速：蓝色渐变 + 亮边，像一颗点亮的按钮 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#4D9BD8FF"
                android:centerColor="#993B9BFF"
                android:endColor="#CC1F7FE8"
                android:type="linear" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#B36FA8FF" />
        </shape>
    </item>
</layer-list>
